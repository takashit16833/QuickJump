    "configuration": {
      "title": "QuickJump",
      "properties": {
        "quickJump.matchMode": {
          "type": "string",
          "enum": ["wordStart", "anywhere"],
          "enumDescriptions": [
            "Match only the start of words and identifiers.",
            "Match every occurrence of the search text."
          ],
          "default": "wordStart",
          "description": "Controls which text positions become jump candidates."
        },
        "quickJump.caseSensitive": {
          "type": "boolean",
          "default": false,
          "description": "Whether search matching is case-sensitive."
        },
        "quickJump.hintCharacters": {
          "type": "string",
          "default": "asdfghjkl",
          "minLength": 2,
          "description": "Characters used to generate jump hints, in priority order."
        },
        "quickJump.revealMode": {
          "type": "string",
          "enum": ["keep", "position"],
          "enumDescriptions": [
            "Keep the current viewport when possible.",
            "Place the destination near the percentage configured by QuickJump: Reveal Position."
          ],
          "default": "keep",
          "description": "Controls whether QuickJump keeps the viewport or places the destination at a configured vertical position."
        },
        "quickJump.revealPosition": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 25,
          "description": "Approximate vertical destination position when QuickJump: Reveal Mode is position. 0 is near top, 50 is near center, and 100 is near bottom."
        }
      }
    }

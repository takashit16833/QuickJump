{
  "name": "quickjump",
  "displayName": "QuickJump",
  "description": "Jump to visible text in VS Code with short search and hint keystrokes.",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "quickJump.jumpOneCharacter",
        "title": "Jump by 1 Character",
        "category": "QuickJump"
      },
      {
        "command": "quickJump.jumpTwoCharacters",
        "title": "Jump by 2 Characters",
        "category": "QuickJump"
      }
    ],
    "colors": [
      {
        "id": "quickJump.hintBackground",
        "description": "Background color of QuickJump hint labels.",
        "defaults": {
          "dark": "#FFD700",
          "light": "#FFD700",
          "highContrast": "#FFFF00",
          "highContrastLight": "#B58900"
        }
      },
      {
        "id": "quickJump.hintForeground",
        "description": "Foreground color of QuickJump hint labels.",
        "defaults": {
          "dark": "#0E1117",
          "light": "#0E1117",
          "highContrast": "#000000",
          "highContrastLight": "#000000"
        }
      }
    ],
    "keybindings": [
      {
        "command": "quickJump.jumpOneCharacter",
        "key": "ctrl+;",
        "when": "editorTextFocus && !quickJump.active"
      },
      {
        "command": "quickJump.jumpTwoCharacters",
        "key": "ctrl+alt+;",
        "when": "editorTextFocus && !quickJump.active"
      },
      {
        "command": "quickJump.cancel",
        "key": "escape",
        "when": "quickJump.active && editorTextFocus"
      },
      {
        "command": "quickJump.backspace",
        "key": "backspace",
        "when": "quickJump.active && editorTextFocus"
      },
      {
